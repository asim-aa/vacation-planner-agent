# Option A: a local OpenAI-compatible model server (e.g. vLLM, Ollama, LM Studio).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy-key
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=120

# Option B: Groq's free tier (https://console.groq.com) -- no local server
# needed, and it hosts this exact same model, so nothing else in this
# project needs to change. No credit card required; rate-limited, not
# unlimited.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=120

# --- Public-deployment request caps (agents/rate_limit.py) ---------------
# The hosted app is unauthenticated, and each plan/refine fans out into LLM
# calls plus live scrapes. These bound cost and keep upstream sources from
# rate-limiting the deployment. Unset values fall back to the defaults shown.
# Set RATE_LIMIT_ENABLED=false for local development.
RATE_LIMIT_ENABLED=true

# Per browser session. Resets when the visitor reloads into a new session.
RATE_LIMIT_SESSION_PLANS=8
RATE_LIMIT_SESSION_REFINEMENTS=30

# Process-wide, shared by every visitor: a sliding window of N plans per
# RATE_LIMIT_GLOBAL_WINDOW_SECONDS.
RATE_LIMIT_GLOBAL_PLANS=120
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
